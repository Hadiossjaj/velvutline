<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sales Fire | Продажи и Мотивация</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #ff4d00;
            --primary-dark: #e04300;
            --bg: #0f0f13;
            --card: #1a1a22;
            --text: #f0f0f0;
            --muted: #a0a0b0;
            --accent: #ffd700;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* ===== HEADER ===== */
        header {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(15, 15, 19, 0.92);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 77, 0, 0.2);
        }

        .nav {
            max-width: 1200px;
            margin: 0 auto;
            padding: 18px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--primary);
            letter-spacing: -0.5px;
        }

        .logo span {
            color: white;
        }

        .nav-links {
            display: flex;
            gap: 32px;
            list-style: none;
        }

        .nav-links a {
            color: var(--text);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            transition: color 0.3s;
        }

        .nav-links a:hover {
            color: var(--primary);
        }

        .btn {
            display: inline-block;
            background: var(--primary);
            color: white;
            padding: 12px 28px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 700;
            transition: all 0.3s;
            border: none;
            cursor: pointer;
            font-size: 1rem;
        }

        .btn:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 77, 0, 0.3);
        }

        /* ===== HERO ===== */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 120px 24px 80px;
            background: radial-gradient(circle at 30% 20%, rgba(255, 77, 0, 0.15), transparent 50%),
                        radial-gradient(circle at 70% 80%, rgba(255, 215, 0, 0.08), transparent 40%);
        }

        .hero-content {
            max-width: 900px;
        }

        .hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.8rem, 7vw, 4.8rem);
            line-height: 1.1;
            margin-bottom: 24px;
        }

        .hero h1 span {
            color: var(--primary);
        }

        .hero p {
            font-size: 1.25rem;
            color: var(--muted);
            margin-bottom: 40px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .hero-buttons {
            display: flex;
            gap: 16px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-outline {
            background: transparent;
            border: 2px solid var(--primary);
            color: var(--primary);
        }

        .btn-outline:hover {
            background: var(--primary);
            color: white;
        }

        /* ===== SECTIONS ===== */
        section {
            padding: 100px 24px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-title {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-title h2 {
            font-size: 2.5rem;
            margin-bottom: 12px;
        }

        .section-title p {
            color: var(--muted);
            font-size: 1.1rem;
        }

        /* ===== MOTIVATION QUOTES ===== */
        .quotes {
            background: var(--card);
        }

        .quotes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 24px;
        }

        .quote-card {
            background: var(--bg);
            padding: 32px;
            border-radius: 16px;
            border-left: 4px solid var(--primary);
            transition: transform 0.3s;
        }

        .quote-card:hover {
            transform: translateY(-6px);
        }

        .quote-card p {
            font-size: 1.15rem;
            font-style: italic;
            margin-bottom: 16px;
        }

        .quote-card .author {
            color: var(--primary);
            font-weight: 700;
            font-size: 0.95rem;
        }

        /* ===== SALES TIPS ===== */
        .tips-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 28px;
        }

        .tip-card {
            background: var(--card);
            padding: 36px 28px;
            border-radius: 16px;
            text-align: center;
            transition: all 0.3s;
            border: 1px solid transparent;
        }

        .tip-card:hover {
            border-color: var(--primary);
            transform: translateY(-8px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.3);
        }

        .tip-icon {
            font-size: 2.8rem;
            margin-bottom: 20px;
        }

        .tip-card h3 {
            font-size: 1.3rem;
            margin-bottom: 12px;
        }

        .tip-card p {
            color: var(--muted);
            font-size: 0.95rem;
        }

        /* ===== CTA + FORM ===== */
        .cta {
            background: linear-gradient(135deg, #1a1a22, #0f0f13);
            position: relative;
            overflow: hidden;
        }

        .cta::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,77,0,0.1) 0%, transparent 60%);
            animation: pulse 8s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.1); opacity: 0.8; }
        }

        .cta-content {
            position: relative;
            z-index: 2;
            max-width: 600px;
            margin: 0 auto;
            text-align: center;
        }

        .cta h2 {
            font-size: 2.6rem;
            margin-bottom: 16px;
        }

        .cta > .cta-content > p {
            color: var(--muted);
            font-size: 1.15rem;
            margin-bottom: 40px;
        }

        /* Форма */
        .form-card {
            background: var(--card);
            padding: 40px 32px;
            border-radius: 20px;
            border: 1px solid rgba(255, 77, 0, 0.25);
            box-shadow: 0 20px 50px rgba(0,0,0,0.4);
            text-align: left;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 14px 16px;
            background: var(--bg);
            border: 1px solid #333;
            border-radius: 10px;
            color: var(--text);
            font-size: 1rem;
            font-family: inherit;
            transition: border-color 0.3s;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--primary);
        }

        .form-group textarea {
            resize: vertical;
            min-height: 100px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .submit-btn {
            width: 100%;
            padding: 16px;
            font-size: 1.1rem;
            margin-top: 10px;
        }

        .success-message {
            display: none;
            background: rgba(0, 200, 80, 0.15);
            border: 1px solid #00c850;
            color: #00e676;
            padding: 16px;
            border-radius: 12px;
            text-align: center;
            margin-top: 20px;
            font-weight: 600;
        }

        /* ===== FOOTER ===== */
        footer {
            background: #0a0a0e;
            padding: 40px 24px;
            text-align: center;
            color: var(--muted);
            font-size: 0.9rem;
            border-top: 1px solid rgba(255,255,255,0.05);
        }

        /* ===== MOBILE ===== */
        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }
            
            .hero h1 {
                font-size: 2.6rem;
            }
            
            section {
                padding: 70px 20px;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .form-card {
                padding: 28px 20px;
            }
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header>
        <nav class="nav">
            <div class="logo">Sales<span>Fire</span></div>
            <ul class="nav-links">
                <li><a href="#motivation">Мотивация</a></li>
                <li><a href="#tips">Техники продаж</a></li>
                <li><a href="#cta">Оставить заявку</a></li>
            </ul>
            <a href="#cta" class="btn">Оставить заявку</a>
        </nav>
    </header>

    <!-- HERO -->
    <section class="hero">
        <div class="hero-content">
            <h1>Продавай <span>огненно</span>.<br>Живи мотивированно.</h1>
            <p>Система, которая превращает обычных людей в топ-продавцов. Мотивация + рабочие техники продаж в одном месте.</p>
            <div class="hero-buttons">
                <a href="#cta" class="btn">Оставить заявку</a>
                <a href="#tips" class="btn btn-outline">Смотреть техники</a>
            </div>
        </div>
    </section>

    <!-- MOTIVATION -->
    <section class="quotes" id="motivation">
        <div class="container">
            <div class="section-title">
                <h2>Топливо для твоих продаж</h2>
                <p>Цитаты, которые поднимают с колен даже в самый тяжёлый день</p>
            </div>
            <div class="quotes-grid">
                <div class="quote-card">
                    <p>«Успех в продажах — это не талант. Это дисциплина + правильный скрипт + вера в продукт.»</p>
                    <div class="author">— Грант Кардон</div>
                </div>
                <div class="quote-card">
                    <p>«Каждый отказ — это просто шаг ближе к следующей сделке. Не принимай "нет" на свой счёт.»</p>
                    <div class="author">— Зиг Зиглар</div>
                </div>
                <div class="quote-card">
                    <p>«Мотивация приходит и уходит. Привычка остаётся. Создай привычку продавать каждый день.»</p>
                    <div class="author">— Sales Fire</div>
                </div>
            </div>
        </div>
    </section>

    <!-- TIPS -->
    <section id="tips">
        <div class="container">
            <div class="section-title">
                <h2>Рабочие техники продаж</h2>
                <p>Не теория. Только то, что реально закрывает сделки</p>
            </div>
            <div class="tips-grid">
                <div class="tip-card">
                    <div class="tip-icon">🎯</div>
                    <h3>Правило 3 «Да»</h3>
                    <p>Получи от клиента три маленьких согласия подряд — и большое «да» становится почти автоматическим.</p>
                </div>
                <div class="tip-card">
                    <div class="tip-icon">🔥</div>
                    <h3>Боль → Решение</h3>
                    <p>Сначала глубоко раскопай боль клиента. Только потом предлагай продукт как лекарство.</p>
                </div>
                <div class="tip-card">
                    <div class="tip-icon">⏱</div>
                    <h3>Дефицит времени</h3>
                    <p>«Это предложение действует только сегодня» работает лучше любой скидки, если использовать честно.</p>
                </div>
                <div class="tip-card">
                    <div class="tip-icon">🧠</div>
                    <h3>Истории вместо фактов</h3>
                    <p>Люди покупают эмоции. Рассказывай истории клиентов, а не характеристики продукта.</p>
                </div>
                <div class="tip-card">
                    <div class="tip-icon">📞</div>
                    <h3>Follow-up система</h3>
                    <p>80% сделок закрываются после 5-го контакта. Большинство сдаётся после второго.</p>
                </div>
                <div class="tip-card">
                    <div class="tip-icon">⚡</div>
                    <h3>Энергия продавца</h3>
                    <p>Клиент покупает твоё состояние. Если ты не веришь — он тоже не поверит.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA + FORM -->
    <section class="cta" id="cta">
        <div class="cta-content">
            <h2>Оставь заявку<br>и начни расти</h2>
            <p>Заполни форму — и мы свяжемся с тобой в течение 15 минут</p>

            <div class="form-card">
                <form id="leadForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="name">Ваше имя *</label>
                            <input type="text" id="name" name="name" required placeholder="Александр">
                        </div>
                        <div class="form-group">
                            <label for="phone">Телефон *</label>
                            <input type="tel" id="phone" name="phone" required placeholder="+7 (999) 123-45-67">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" placeholder="alex@mail.ru">
                    </div>

                    <div class="form-group">
                        <label for="message">Что вас интересует?</label>
                        <textarea id="message" name="message" placeholder="Хочу получить доступ к системе / Нужна консультация..."></textarea>
                    </div>

                    <button type="submit" class="btn submit-btn">Отправить заявку</button>

                    <div class="success-message" id="successMessage">
                        ✅ Заявка успешно отправлена! Мы скоро свяжемся с вами.
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer>
        <p>© 2026 Sales Fire. Все права защищены. Создано для тех, кто хочет продавать больше.</p>
    </footer>

    <script>
        // Плавная прокрутка
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        // Обработка формы
        const form = document.getElementById('leadForm');
        const successMessage = document.getElementById('successMessage');

        form.addEventListener('submit', function(e) {
            e.preventDefault();

            // Здесь можно добавить отправку на сервер (fetch / Formspree / Telegram и т.д.)
            // Пока просто показываем сообщение об успехе

            successMessage.style.display = 'block';
            form.reset();

            // Скрываем сообщение через 5 секунд
            setTimeout(() => {
                successMessage.style.display = 'none';
            }, 5000);
        });
    </script>
</body>
</html>